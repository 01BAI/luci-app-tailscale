{
	"luci-app-tailscale": {
		"description": "Grant access to Tailscale management",
		"read": {
			"ubus": {
				"tailscale": [
					"get_overview",
					"get_status",
					"get_login_progress",
					"get_install_progress",
					"get_up_settings",
					"list_versions",
					"check_update",
					"check_download_network",
					"preview_up_command"
				]
			},
			"uci": [ "tailscale" ],
			"file": {
				"/etc/tailscale/*": [ "read" ],
				"/etc/config/tailscaled.state": [ "read" ],
				"/var/log/tailscale*.log": [ "read" ],
				"/tmp/tailscale_luci_install.log": [ "read" ]
			}
		},
		"write": {
			"ubus": {
				"tailscale": [
					"run_install",
					"run_uninstall",
					"set_up_settings",
					"apply_up_settings",
					"apply_saved_up",
					"start_login",
					"do_login",
					"do_logout",
					"set_service_enabled"
				]
			},
			"uci": [ "tailscale" ],
			"file": {
				"/etc/tailscale/*": [ "write" ],
				"/etc/config/tailscaled.state": [ "write" ]
			}
		}
	}
}
